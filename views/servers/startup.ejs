<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-rocket"></i>
            Startup & Runtime Configuration
        </h1>
        <p class="page-subtitle"><%= server.name %> (<%= server.runtime_type || 'minecraft' %>)</p>
    </div>
    <a href="/servers/<%= server.id %>/dashboard" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i>
        Back to Dashboard
    </a>
</div>

<!-- Process Startup Command Settings (For Minecraft, Node.js, Python) -->
<div class="card card-gradient-primary">
    <div class="card-header">
        <h3><i class="fas fa-terminal"></i> Process Startup Configuration</h3>
        <span class="badge badge-success">Editable</span>
    </div>
    <div class="card-body">
        <form id="startupCommandForm" onsubmit="saveStartupCommand(event)">
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-play"></i>
                    Startup Command *
                </label>
                <div class="input-wrapper">
                    <input type="text" name="startup_command" id="startupCommandInput" class="form-control" 
                           value="<%= server.startup_command || (typeof startup === 'string' ? startup : '') %>" 
                           placeholder="<%= server.runtime_type === 'nodejs' ? 'node index.js' : server.runtime_type === 'python' ? 'python3 bot.py' : 'java -Xms512M -Xmx' + server.ram + 'M -jar server.jar nogui' %>"
                           style="font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 500;">
                    <i class="fas fa-terminal input-icon"></i>
                </div>
                <small class="help-text">
                    <i class="fas fa-info-circle"></i>
                    The exact shell command executed to launch this server or bot process.
                </small>
                
                <!-- Quick Command Presets -->
                <div style="display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap;">
                    <span style="font-size: 12px; color: var(--text-muted); align-self: center;">Quick Presets:</span>
                    <% if (server.runtime_type === 'nodejs') { %>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('node index.js')">node index.js</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('node bot.js')">node bot.js</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('npm start')">npm start</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('npm run dev')">npm run dev</button>
                    <% } else if (server.runtime_type === 'python') { %>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('python3 bot.py')">python3 bot.py</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('python3 main.py')">python3 main.py</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('python bot.py')">python bot.py</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('python main.py')">python main.py</button>
                    <% } else { %>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('java -Xms512M -Xmx<%= server.ram %>M -jar server.jar nogui')">Standard Java</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="setPreset('java -Xms<%= Math.floor(server.ram/2) %>M -Xmx<%= server.ram %>M -XX:+UseG1GC -jar server.jar nogui')">Aikar Flags G1GC</button>
                    <% } %>
                </div>
            </div>

            <div class="row" style="margin-top: 16px;">
                <div class="col-6">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-folder"></i>
                            Working Directory
                        </label>
                        <div class="input-wrapper">
                            <input type="text" name="working_directory" id="workingDirInput" class="form-control" 
                                   value="<%= server.working_directory || '.' %>" placeholder="." style="font-family: monospace;">
                            <i class="fas fa-folder input-icon"></i>
                        </div>
                        <small class="help-text">Relative working directory for script execution (default: <code>.</code>)</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-network-wired"></i>
                            Assigned Port
                        </label>
                        <div class="input-wrapper">
                            <input type="text" class="form-control" value="<%= server.port %>" disabled style="font-family: monospace;">
                            <i class="fas fa-network-wired input-icon"></i>
                        </div>
                        <small class="help-text">Injected into runtime environment as <code>PORT=<%= server.port %></code></small>
                    </div>
                </div>
            </div>

            <div class="form-group" style="margin-top: 16px;">
                <label class="form-label">
                    <i class="fas fa-key"></i>
                    Environment Variables (Synced to <code>.env</code>)
                </label>
                <textarea name="environment_variables" id="envVarsInput" class="form-control" rows="5" 
                          placeholder="TOKEN=your_bot_token_here&#10;PREFIX=!&#10;NODE_ENV=production"
                          style="font-family: 'JetBrains Mono', monospace; font-size: 13px; line-height: 1.5;"><%= server.environment_variables || '' %></textarea>
                <small class="help-text">
                    <i class="fas fa-info-circle"></i>
                    Key-Value pairs (e.g. <code>BOT_TOKEN=xyz</code>) passed to the bot process and synced to the instance's <code>.env</code> file.
                </small>
            </div>

            <div class="form-actions" style="margin-top: 20px;">
                <button type="submit" class="btn btn-primary" id="saveStartupBtn">
                    <i class="fas fa-save"></i>
                    Save Startup Configuration
                </button>
            </div>
        </form>
    </div>
</div>

<% if (!server.runtime_type || server.runtime_type === 'minecraft') { %>
<!-- Minecraft Server Properties (Only shown for Minecraft instances) -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-sliders-h"></i> Minecraft Server Properties (server.properties)</h3>
        <span class="badge badge-success">Editable</span>
    </div>
    <div class="card-body">
        <form id="propertiesForm" onsubmit="saveProperties(event)">
            <div class="properties-grid">
                <!-- Left Column -->
                <div class="properties-column">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-users"></i>
                            Max Players
                        </label>
                        <input type="number" name="max-players" class="form-control" value="<%= properties && properties['max-players'] ? properties['max-players'] : 20 %>" min="1" max="1000">
                        <small class="help-text">Maximum number of players allowed</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-gamepad"></i>
                            Gamemode
                        </label>
                        <select name="gamemode" class="form-control">
                            <option value="survival" <%= properties && properties.gamemode === 'survival' ? 'selected' : '' %>>Survival</option>
                            <option value="creative" <%= properties && properties.gamemode === 'creative' ? 'selected' : '' %>>Creative</option>
                            <option value="adventure" <%= properties && properties.gamemode === 'adventure' ? 'selected' : '' %>>Adventure</option>
                            <option value="spectator" <%= properties && properties.gamemode === 'spectator' ? 'selected' : '' %>>Spectator</option>
                        </select>
                        <small class="help-text">Default gamemode for new players</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-skull-crossbones"></i>
                            Difficulty
                        </label>
                        <select name="difficulty" class="form-control">
                            <option value="peaceful" <%= properties && properties.difficulty === 'peaceful' ? 'selected' : '' %>>Peaceful</option>
                            <option value="easy" <%= properties && properties.difficulty === 'easy' ? 'selected' : '' %>>Easy</option>
                            <option value="normal" <%= properties && properties.difficulty === 'normal' ? 'selected' : '' %>>Normal</option>
                            <option value="hard" <%= properties && properties.difficulty === 'hard' ? 'selected' : '' %>>Hard</option>
                        </select>
                        <small class="help-text">Game difficulty level</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-eye"></i>
                            View Distance
                        </label>
                        <input type="number" name="view-distance" class="form-control" value="<%= properties && properties['view-distance'] ? properties['view-distance'] : 10 %>" min="3" max="32">
                        <small class="help-text">Chunks visible to players (3-32)</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-comment"></i>
                            MOTD (Message of the Day)
                        </label>
                        <input type="text" name="motd" class="form-control" value="<%= properties && properties.motd ? properties.motd : 'A Minecraft Server' %>" placeholder="A Minecraft Server">
                        <small class="help-text">Server description in server list</small>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="properties-column">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-globe"></i>
                            Level Name
                        </label>
                        <input type="text" name="level-name" class="form-control" value="<%= properties && properties['level-name'] ? properties['level-name'] : 'world' %>" placeholder="world">
                        <small class="help-text">World/level folder name</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-mountain"></i>
                            Level Type
                        </label>
                        <select name="level-type" class="form-control">
                            <option value="default" <%= properties && properties['level-type'] === 'default' ? 'selected' : '' %>>Default</option>
                            <option value="flat" <%= properties && properties['level-type'] === 'flat' ? 'selected' : '' %>>Flat</option>
                            <option value="largeBiomes" <%= properties && properties['level-type'] === 'largeBiomes' ? 'selected' : '' %>>Large Biomes</option>
                            <option value="amplified" <%= properties && properties['level-type'] === 'amplified' ? 'selected' : '' %>>Amplified</option>
                        </select>
                        <small class="help-text">World generation type</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-seedling"></i>
                            Level Seed
                        </label>
                        <input type="text" name="level-seed" class="form-control" value="<%= properties && properties['level-seed'] ? properties['level-seed'] : '' %>" placeholder="Leave empty for random">
                        <small class="help-text">World generation seed (optional)</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-tachometer-alt"></i>
                            Simulation Distance
                        </label>
                        <input type="number" name="simulation-distance" class="form-control" value="<%= properties && properties['simulation-distance'] ? properties['simulation-distance'] : 10 %>" min="3" max="32">
                        <small class="help-text">Distance for mob spawning and updates (3-32)</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user-shield"></i>
                            Max World Size
                        </label>
                        <input type="number" name="max-world-size" class="form-control" value="<%= properties && properties['max-world-size'] ? properties['max-world-size'] : 29999984 %>" min="1" max="29999984">
                        <small class="help-text">Maximum world border radius</small>
                    </div>
                </div>
            </div>

            <!-- Server Features Toggles -->
            <div class="toggles-section">
                <h4><i class="fas fa-toggle-on"></i> Server Features</h4>
                <div class="toggles-grid">
                    <label class="toggle-item">
                        <input type="checkbox" name="pvp" <%= properties && properties.pvp !== 'false' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-swords"></i>
                            <div>
                                <strong>Enable PvP</strong>
                                <small>Allow player vs player combat</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="online-mode" <%= properties && properties['online-mode'] !== 'false' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <strong>Online Mode</strong>
                                <small>Require Mojang authentication</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="white-list" <%= properties && properties['white-list'] === 'true' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-list"></i>
                            <div>
                                <strong>Whitelist</strong>
                                <small>Only allow whitelisted players</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="allow-flight" <%= properties && properties['allow-flight'] === 'true' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-plane"></i>
                            <div>
                                <strong>Allow Flight</strong>
                                <small>Enable flying in survival mode</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="spawn-monsters" <%= properties && properties['spawn-monsters'] !== 'false' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-ghost"></i>
                            <div>
                                <strong>Spawn Monsters</strong>
                                <small>Enable hostile mob spawning</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="spawn-animals" <%= properties && properties['spawn-animals'] !== 'false' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-paw"></i>
                            <div>
                                <strong>Spawn Animals</strong>
                                <small>Enable passive mob spawning</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="spawn-npcs" <%= properties && properties['spawn-npcs'] !== 'false' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-user-tie"></i>
                            <div>
                                <strong>Spawn NPCs</strong>
                                <small>Enable villager spawning</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="enable-command-block" <%= properties && properties['enable-command-block'] === 'true' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-cube"></i>
                            <div>
                                <strong>Command Blocks</strong>
                                <small>Enable command block usage</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="generate-structures" <%= properties && properties['generate-structures'] !== 'false' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-building"></i>
                            <div>
                                <strong>Generate Structures</strong>
                                <small>Enable villages, temples, etc.</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="hardcore" <%= properties && properties.hardcore === 'true' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-skull"></i>
                            <div>
                                <strong>Hardcore Mode</strong>
                                <small>Permanent death, locked to hard</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="allow-nether" <%= properties && properties['allow-nether'] !== 'false' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-fire"></i>
                            <div>
                                <strong>Allow Nether</strong>
                                <small>Enable Nether dimension</small>
                            </div>
                        </span>
                    </label>

                    <label class="toggle-item">
                        <input type="checkbox" name="enable-status" <%= properties && properties['enable-status'] !== 'false' ? 'checked' : '' %>>
                        <span class="toggle-content">
                            <i class="fas fa-signal"></i>
                            <div>
                                <strong>Server Status</strong>
                                <small>Show in server list</small>
                            </div>
                        </span>
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    Save Server Properties
                </button>
                <button type="button" class="btn btn-secondary" onclick="resetForm()">
                    <i class="fas fa-undo"></i>
                    Reset Changes
                </button>
            </div>
        </form>
    </div>
</div>
<% } %>

<%- include('../partials/footer') %>

<style>
.card-gradient-primary {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(37, 99, 235, 0.08) 100%);
    border: 1px solid rgba(59, 130, 246, 0.25);
}
.card-gradient-primary .card-header {
    background: rgba(59, 130, 246, 0.1);
    border-bottom: 1px solid rgba(59, 130, 246, 0.25);
}
.properties-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 24px;
}
.properties-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.toggles-section {
    border-top: 1px solid var(--border-primary);
    padding-top: 24px;
    margin-top: 24px;
    margin-bottom: 24px;
}
.toggles-section h4 {
    margin-bottom: 16px;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
}
.toggles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
}
.toggle-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px;
    background: var(--bg-card);
    border: 2px solid var(--border-primary);
    border-radius: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
}
.toggle-item:hover {
    border-color: var(--accent-primary);
    background: var(--bg-elevated);
}
.toggle-item input[type="checkbox"] {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--accent-primary);
    flex-shrink: 0;
}
.toggle-content {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 10px;
}
.toggle-content i {
    color: var(--accent-primary);
    font-size: 18px;
    margin-top: 2px;
    flex-shrink: 0;
}
.toggle-content strong {
    display: block;
    color: var(--text-primary);
    font-size: 14px;
    margin-bottom: 2px;
    font-weight: 600;
}
.toggle-content small {
    display: block;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.4;
}
.form-actions {
    display: flex;
    gap: 12px;
    padding-top: 8px;
    flex-wrap: wrap;
}
@media (max-width: 992px) {
    .properties-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<script>
const serverId = '<%= server.id %>';

function setPreset(cmd) {
    document.getElementById('startupCommandInput').value = cmd;
}

async function saveStartupCommand(e) {
    e.preventDefault();
    const btn = document.getElementById('saveStartupBtn');
    const origText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

    const startup_command = document.getElementById('startupCommandInput').value;
    const working_directory = document.getElementById('workingDirInput').value;
    const environment_variables = document.getElementById('envVarsInput').value;

    try {
        const response = await fetch(`/servers/${serverId}/startup/update`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                startup: startup_command,
                startup_command,
                working_directory,
                environment_variables
            })
        });

        const result = await response.json();
        if (result.success || response.ok) {
            showToast('success', '✅ Startup configuration updated successfully! Restart the process to apply changes.');
        } else {
            showToast('error', '❌ Error: ' + (result.error || 'Failed to update startup configuration'));
        }
    } catch (err) {
        showToast('error', '❌ Network error updating startup configuration');
    } finally {
        btn.disabled = false;
        btn.innerHTML = origText;
    }
}

async function saveProperties(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = {};
    
    for (let [key, value] of formData.entries()) {
        const input = e.target.elements[key];
        if (input && input.type === 'checkbox') {
            data[key] = input.checked ? 'true' : 'false';
        } else {
            data[key] = value;
        }
    }
    
    const checkboxes = e.target.querySelectorAll('input[type="checkbox"]');
    checkboxes.forEach(checkbox => {
        if (!formData.has(checkbox.name)) {
            data[checkbox.name] = 'false';
        }
    });
    
    const btn = e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    btn.disabled = true;
    
    try {
        const response = await fetch(`/servers/${serverId}/startup/update`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ properties: data })
        });
        
        const result = await response.json();
        if (result.success || response.ok) {
            showToast('success', '✅ Server properties saved successfully! Restart the server to apply changes.');
        } else {
            showToast('error', '❌ Error: ' + (result.error || 'Failed to save server properties'));
        }
    } catch (err) {
        showToast('error', '❌ Network error: Unable to save server properties.');
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}

function resetForm() {
    if (confirm('Are you sure you want to reset all changes?')) {
        document.getElementById('propertiesForm').reset();
        showToast('warning', '⚠️ Form reset to original values');
    }
}

function showToast(type, message) {
    const toast = document.createElement('div');
    toast.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        background: ${type === 'success' ? 'linear-gradient(45deg, #10b981, #34ce57)' : 
                     type === 'error' ? 'linear-gradient(45deg, #ef4444, #dc2626)' : 
                     'linear-gradient(45deg, #f59e0b, #fbbf24)'};
        color: white;
        padding: 16px 20px;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        z-index: 10001;
        max-width: 400px;
        font-size: 14px;
        font-weight: 500;
        animation: slideInRight 0.4s ease;
        display: flex;
        align-items: center;
        gap: 12px;
    `;
    
    const icon = type === 'success' ? 'check-circle' : 
                 type === 'error' ? 'exclamation-circle' : 
                 'exclamation-triangle';
    
    toast.innerHTML = `
        <i class="fas fa-${icon}" style="font-size: 18px;"></i>
        <span>${message}</span>
    `;
    
    document.body.appendChild(toast);
    
    setTimeout(() => {
        toast.style.animation = 'slideOutRight 0.4s ease';
        setTimeout(() => toast.remove(), 400);
    }, 5000);
}
</script>
