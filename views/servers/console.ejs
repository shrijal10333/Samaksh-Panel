<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-terminal"></i>
            Interactive Live Console
        </h1>
        <p class="page-subtitle"><%= server.name %> &bull; <span class="badge <%= server.status === 'running' ? 'badge-success' : 'badge-danger' %>"><%= server.status %></span> (<%= server.runtime_type || 'minecraft' %>)</p>
    </div>
    <div class="page-actions" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button class="btn <%= server.status === 'running' ? 'btn-danger' : 'btn-success' %> btn-sm" onclick="toggleServer()">
            <i class="fas fa-<%= server.status === 'running' ? 'stop' : 'play' %>"></i>
            <%= server.status === 'running' ? 'Stop' : 'Start' %>
        </button>
        <button class="btn btn-warning btn-sm" onclick="restartServer()" <%= server.status !== 'running' ? 'disabled' : '' %>>
            <i class="fas fa-sync-alt"></i>
            Restart
        </button>
        <button class="btn btn-danger btn-sm" onclick="killServer()" <%= server.status !== 'running' ? 'disabled' : '' %>>
            <i class="fas fa-skull"></i>
            Kill
        </button>
        <button class="btn btn-secondary btn-sm" onclick="clearConsole()">
            <i class="fas fa-eraser"></i>
            Clear
        </button>
        <button class="btn btn-secondary btn-sm" onclick="toggleAutoScroll()">
            <i class="fas fa-arrows-alt-v"></i>
            <span id="autoScrollText">Auto-scroll: ON</span>
        </button>
    </div>
</div>

<!-- Console Output -->
<div class="card">
    <div class="card-body" style="padding: 0;">
        <div id="console" style="background: #0d1117; color: #c9d1d9; font-family: 'JetBrains Mono', 'Courier New', monospace; font-size: 13px; line-height: 1.5; padding: 20px; height: 500px; overflow-y: auto; border-radius: 12px; border: 1px solid var(--border-primary);">
            <% if (logContent) { %>
                <pre style="margin: 0; white-space: pre-wrap; word-wrap: break-word;"><%= logContent %></pre>
            <% } else { %>
                <p style="color: #6e7681; margin: 0;">Console initialized. Start the process to stream live stdout/stderr.</p>
            <% } %>
        </div>
    </div>
</div>

<!-- Command Input -->
<% if (server.status === 'running') { %>
<div class="card" style="margin-top: 16px;">
    <div class="card-body">
        <form onsubmit="sendCommand(event)" style="display: flex; gap: 12px;">
            <div class="input-wrapper" style="flex: 1;">
                <input type="text" id="commandInput" class="form-control" placeholder="<%= server.runtime_type === 'nodejs' || server.runtime_type === 'python' ? 'Send stdin input to bot process...' : 'Enter server command (e.g. say, op, whitelist, gamemode)...' %>" style="font-family: monospace;" autocomplete="off" autofocus>
                <i class="fas fa-terminal input-icon"></i>
            </div>
            <button type="submit" class="btn btn-primary" id="sendBtn">
                <i class="fas fa-paper-plane"></i>
                Send Command
            </button>
        </form>
        <div style="margin-top: 12px; color: var(--text-muted); font-size: 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <strong>Quick Commands:</strong>
            <% if (!server.runtime_type || server.runtime_type === 'minecraft') { %>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('list')">list</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('help')">help</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('tps')">tps</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('whitelist list')">whitelist</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('say Hello world!')">say Hello!</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('save-all')">save-all</button>
            <% } else if (server.runtime_type === 'nodejs') { %>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('help')">help</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('status')">status</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('ping')">ping</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('stats')">stats</button>
            <% } else { %>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('help')">help</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('status')">status</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('ping')">ping</button>
                <button class="btn btn-sm btn-secondary" onclick="quickCommand('info')">info</button>
            <% } %>
        </div>
    </div>
</div>
<% } else { %>
<div class="alert alert-warning" style="margin-top: 16px;">
    <i class="fas fa-exclamation-triangle"></i>
    <span>Process is currently stopped. Start the instance to send interactive commands and stream live output.</span>
</div>
<% } %>

<script>
const serverId = <%= server.id %>;
const consoleDiv = document.getElementById('console');
let autoScroll = true;
let socket = null;

function toggleServer() {
    const action = '<%= server.status %>' === 'running' ? 'stop' : 'start';
    if (!confirm(`Are you sure you want to ${action} this instance?`)) return;
    
    fetch(`/servers/${serverId}/${action}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            setTimeout(() => location.reload(), 1500);
        } else {
            alert('Error: ' + (data.error || `Failed to ${action} process`));
        }
    })
    .catch(err => {
        console.error('Error:', err);
        alert('An error occurred');
    });
}

function restartServer() {
    if (!confirm('Are you sure you want to restart this instance?')) return;
    fetch(`/servers/${serverId}/restart`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            setTimeout(() => location.reload(), 2000);
        } else {
            alert('Error: ' + (data.error || 'Failed to restart'));
        }
    })
    .catch(err => alert('An error occurred'));
}

function killServer() {
    if (!confirm('Are you sure you want to forcefully KILL this process immediately?')) return;
    fetch(`/servers/${serverId}/kill`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            setTimeout(() => location.reload(), 1000);
        } else {
            alert('Error: ' + (data.error || 'Failed to kill process'));
        }
    })
    .catch(err => alert('An error occurred'));
}

// Auto-scroll to bottom
function scrollToBottom() {
    if (autoScroll) {
        consoleDiv.scrollTop = consoleDiv.scrollHeight;
    }
}
scrollToBottom();

function toggleAutoScroll() {
    autoScroll = !autoScroll;
    document.getElementById('autoScrollText').textContent = `Auto-scroll: ${autoScroll ? 'ON' : 'OFF'}`;
}

function clearConsole() {
    if (confirm('Clear console output window?')) {
        consoleDiv.innerHTML = '<p style="color: #6e7681; margin: 0;">Console cleared</p>';
    }
}

function sendCommand(e) {
    e.preventDefault();
    const input = document.getElementById('commandInput');
    const command = input.value.trim();
    if (!command) return;
    
    // Add command to history
    if (!commandHistory.includes(command)) {
        commandHistory.push(command);
        if (commandHistory.length > 50) {
            commandHistory.shift();
        }
    }
    historyIndex = -1;
    
    fetch(`/servers/${serverId}/command`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            input.value = '';
            // Add command to console preview
            const pre = document.createElement('pre');
            pre.style.margin = '0';
            pre.style.color = '#38bdf8';
            pre.style.fontWeight = 'bold';
            pre.textContent = '> ' + command;
            consoleDiv.appendChild(pre);
            scrollToBottom();
        } else {
            const errorDiv = document.createElement('div');
            errorDiv.style.cssText = 'margin: 6px 0; padding: 10px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 6px; color: #ef4444;';
            errorDiv.innerHTML = '<strong>⚠️ Command Error:</strong> ' + (data.error || 'Failed to send command');
            consoleDiv.appendChild(errorDiv);
            scrollToBottom();
        }
    })
    .catch(err => {
        console.error('Error:', err);
    });
}

function quickCommand(cmd) {
    const input = document.getElementById('commandInput');
    if (input) {
        input.value = cmd;
        input.focus();
    }
}

// Socket.IO for live console updates
function initializeSocket() {
    if (socket) {
        socket.disconnect();
    }
    
    socket = io();
    
    socket.emit('join-server', serverId);
    
    socket.on('console', (data) => {
        let output = '';
        if (typeof data === 'string') {
            output = data;
        } else if (data && data.line) {
            output = data.line;
        } else if (data && data.serverId === serverId) {
            output = data.output || data.message || '';
        }
        
        if (output) {
            const pre = document.createElement('pre');
            pre.style.margin = '0';
            pre.style.whiteSpace = 'pre-wrap';
            pre.style.wordWrap = 'break-word';
            
            if (output.includes('[ERROR]') || output.includes('Error:') || output.includes('Traceback (most recent call last)')) {
                pre.style.color = '#f87171';
            } else if (output.includes('[WARN]') || output.includes('Warning:')) {
                pre.style.color = '#fbbf24';
            } else if (output.includes('[INFO]')) {
                pre.style.color = '#e2e8f0';
            } else if (output.includes('[PANEL]')) {
                pre.style.color = '#38bdf8';
                pre.style.fontWeight = 'bold';
            } else {
                pre.style.color = '#c9d1d9';
            }
            
            pre.textContent = output;
            consoleDiv.appendChild(pre);
            scrollToBottom();
            
            while (consoleDiv.children.length > 1000) {
                consoleDiv.removeChild(consoleDiv.firstChild);
            }
        }
    });
    
    socket.on('connect', () => {
        const statusMsg = document.createElement('pre');
        statusMsg.style.margin = '0';
        statusMsg.style.color = '#34d399';
        statusMsg.style.fontWeight = 'bold';
        statusMsg.textContent = '[PANEL] Connected to process output stream\n';
        consoleDiv.appendChild(statusMsg);
        scrollToBottom();
    });
}

initializeSocket();

window.addEventListener('beforeunload', () => {
    if (socket) {
        socket.emit('leave-server', serverId);
        socket.disconnect();
    }
});

// Command history
const commandHistory = [];
let historyIndex = -1;

const commandInput = document.getElementById('commandInput');
if (commandInput) {
    commandInput.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (historyIndex < commandHistory.length - 1) {
                historyIndex++;
                e.target.value = commandHistory[commandHistory.length - 1 - historyIndex];
            }
        } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (historyIndex > 0) {
                historyIndex--;
                e.target.value = commandHistory[commandHistory.length - 1 - historyIndex];
            } else {
                historyIndex = -1;
                e.target.value = '';
            }
        }
    });
}
</script>

<%- include('../partials/footer') %>
